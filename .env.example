# ─── Database ────────────────────────────────────────────────────────────────
# Dipakai oleh container Postgres DAN sebagai bagian dari DATABASE_URL.
POSTGRES_USER=saku
POSTGRES_PASSWORD=ganti-password-db-ini
POSTGRES_DB=saku

# ─── Aplikasi web ────────────────────────────────────────────────────────────
# Port dashboard di host. Buka http://<ip-homeserver>:3000
APP_PORT=3000

# Kunci rahasia untuk cookie sesi login.
# Buat dengan: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-hasil-openssl-rand-base64-32

# Zona waktu untuk menentukan "hari ini", "bulan ini", laporan, dll.
APP_TIMEZONE=Asia/Jakarta

# Set ke 1 jika dashboard diakses lewat HTTPS (mis. di belakang reverse proxy atau tunneling).
COOKIE_SECURE=0

# ─── Akun admin pertama ──────────────────────────────────────────────────────
# Dibuat otomatis saat container web pertama kali jalan.
# Nomor WA format 62xxx (tanpa +, tanpa spasi).
ADMIN_NAME=Admin
ADMIN_WA_NUMBER=6281234567890
ADMIN_PASSWORD=password-pertama-yang-kuat

# ─── Jembatan bot WhatsApp <-> web ───────────────────────────────────────────
# Token internal supaya dashboard bisa membaca status/QR bot.
# Buat dengan: openssl rand -hex 24
BOT_TOKEN=ganti-dengan-token-acak

# ─── Opsional ────────────────────────────────────────────────────────────────
# Level log bot: trace | debug | info | warn | error
LOG_LEVEL=info

# Untuk pengembangan lokal tanpa Docker. Saat memakai docker compose,
# DATABASE_URL diisi otomatis oleh compose dan baris ini tidak perlu diaktifkan.
# DATABASE_URL=postgresql://saku:ganti-password-db-ini@localhost:5432/saku?schema=public
#
# Alamat status bot untuk dashboard (otomatis http://wa:3002 di Docker).
# WA_BOT_URL=http://localhost:3002
