# ─── Database ────────────────────────────────────────────────────────────────
# Dipakai oleh container Postgres DAN sebagai bagian dari DATABASE_URL.
# POSTGRES_PASSWORD minimal 12 karakter. Jangan pakai @ : / # ? & atau spasi
# karena nilainya dirangkai menjadi URL koneksi. Buat dengan: openssl rand -hex 16
POSTGRES_USER=saku
POSTGRES_PASSWORD=ganti-password-db-ini
POSTGRES_DB=saku

# ─── Aplikasi web ────────────────────────────────────────────────────────────
# Port dashboard di host. Buka http://<ip-homeserver>:3000
APP_PORT=3000

# Kunci rahasia untuk cookie sesi login. Minimal 32 karakter.
# Buat dengan: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-hasil-openssl-rand-base64-32

# Zona waktu untuk menentukan "hari ini", "bulan ini", laporan, dll.
APP_TIMEZONE=Asia/Jakarta

# Set ke 1 jika dashboard diakses lewat HTTPS (mis. di belakang reverse proxy atau tunneling).
COOKIE_SECURE=0

# ─── Akun admin pertama ──────────────────────────────────────────────────────
# Dibuat otomatis saat container web pertama kali jalan.
# Nomor WA format 62xxx (tanpa +, tanpa spasi).
# ADMIN_NAME harus unik karena bisa dipakai untuk login selain nomor WA.
# ADMIN_PASSWORD minimal 8 karakter; 12+ sangat disarankan.
ADMIN_NAME=Admin
ADMIN_WA_NUMBER=6281234567890
ADMIN_PASSWORD=password-pertama-yang-kuat

# ─── Jembatan bot WhatsApp <-> web ───────────────────────────────────────────
# Token internal supaya dashboard bisa membaca status/QR bot. Minimal 24 karakter.
# Buat dengan: openssl rand -hex 24
BOT_TOKEN=ganti-dengan-token-acak

# ─── Opsional ────────────────────────────────────────────────────────────────
# Level log bot: trace | debug | info | warn | error
# Gunakan info di produksi. Level debug mencatat cuplikan isi pesan WhatsApp.
LOG_LEVEL=info

# Untuk pengembangan lokal tanpa Docker. Saat memakai docker compose,
# DATABASE_URL diisi otomatis oleh compose dan baris ini tidak perlu diaktifkan.
# DATABASE_URL=postgresql://saku:ganti-password-db-ini@localhost:5432/saku?schema=public
#
# Alamat status bot untuk dashboard (otomatis http://wa:3002 di Docker).
# WA_BOT_URL=http://localhost:3002

# ─── Anti-blokir WhatsApp (opsional) ─────────────────────────────────────────
# Bot memberi jeda acak dan indikator "mengetik" sebelum membalas, serta
# membatasi jumlah pesan keluar agar nomor tidak dicurigai sebagai spam.
# Nilai di bawah adalah default yang aman untuk keluarga kecil.
WA_SEND_MIN_DELAY_MS=900
WA_SEND_MAX_DELAY_MS=2600
WA_MINUTE_MESSAGE_LIMIT=15
WA_DAILY_MESSAGE_LIMIT=1000
WA_NON_TEXT_COOLDOWN_MS=1800000
WA_TYPING_MIN_MS=700
WA_TYPING_MAX_MS=2200

# ─── Log & backup (opsional) ─────────────────────────────────────────────────
# Lokasi file log di dalam container (diisi otomatis oleh docker compose).
# LOG_LEVEL=info
# LOG_MAX_BYTES=5242880
# LOG_MAX_FILES=3
